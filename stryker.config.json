{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"packageManager": "npm",
	"testRunner": "vitest",
	"vitest": {
		"configFile": "vitest.config.ts"
	},
	"coverageAnalysis": "perTest",
	"mutate": [
		"src/chat/durable-replay.ts"
	],
	"testFiles": [
		"src/chat/__tests__/durable-replay.test.ts"
	],
	"reporters": ["clear-text", "html", "json"],
	"thresholds": {
		"high": 80,
		"low": 60,
		"break": 50
	},
	"timeoutMS": 60000,
	"concurrency": 2,
	"ignoreStatic": true
}
